# Banco
DB_USER=fuel
DB_PASSWORD=fuel
DB_NAME=fuel
DATABASE_URL=postgresql+psycopg2://fuel:fuel@db:5432/fuel

# Sessão
SECRET_KEY=troque-isto-por-algo-bem-aleatorio

# Admin inicial (criado no primeiro start se não existir)
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=trocar123

# SEFAZ - certificado A1 (.pfx) montado em ./certs
CERT_PATH=/app/certs/certificado.pfx
CERT_PASSWORD=senha-do-certificado
SEFAZ_AMBIENTE=1                # 1=produção, 2=homologação
SEFAZ_UF=SP                     # UF do autor (consultante)

# Polling (segundos)
POLL_INTERVAL=900               # 15min

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@empresa.com.br
SMTP_TLS=true

# Limites de alerta (% da cota)
ALERT_THRESHOLDS=70,85,95,100
