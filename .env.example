# Banco
DB_USER=fuel
DB_PASSWORD=fuel
DB_NAME=fuel
DATABASE_URL=postgresql+psycopg2://fuel:fuel@db:5432/fuel

# Sessão
SECRET_KEY=troque-isto-por-algo-bem-aleatorio

# Login do painel
AUTH_EMAIL=admin@empresa.com.br
AUTH_PASSWORD=trocar123

# Empresa (1 deploy = 1 empresa)
EMPRESA_NOME=Minha Empresa LTDA
EMPRESA_CNPJ=00000000000000        # apenas dígitos
COTA_LITROS=1220000
PERIODO_INICIO=2025-01-01
PERIODO_FIM=2025-06-30
EMAIL_ALERTAS=financeiro@empresa.com.br

# SEFAZ (NFeDistribuicaoDFe + NFeRecepcaoEvento4) - certificado A1 .pfx
# NFeDistribuicaoDFe é NACIONAL: uma única consulta retorna todas as NFe
# emitidas contra o seu CNPJ, de qualquer estado. SEFAZ_UF aqui é apenas
# a UF do consultante (você) para roteamento interno - NÃO filtra emitente.
CERT_PATH=/app/certs/certificado.pfx
CERT_PASSWORD=senha-do-certificado
SEFAZ_AMBIENTE=1                    # 1=produção, 2=homologação
SEFAZ_UF=MG                         # UF do consultante (cUFAutor)

# Manifestação de ciência automática (evento 210210).
# RECOMENDADO=true para essa automação: resumos não têm itens (só cabeçalho),
# então só conseguimos saber se uma NFe é diesel APÓS manifestar e baixar a
# NFe completa (consChNFe). Resumos que não forem diesel são deletados auto.
# Tem efeito jurídico (dá ciência da operação ao fisco); combine com o contador.
MANIFESTAR_AUTO=true

# Polling
POLL_INTERVAL=900                   # 15min
MIN_SEFAZ_INTERVAL=60               # intervalo mínimo entre consultas (anti cStat 656)

# Localização
TZ=America/Sao_Paulo

# Logo da empresa - URL completa (https://...) OU nome de arquivo em
# app/static/ (ex.: empresa.png). Vazio = só o ícone padrão.
EMPRESA_LOGO=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@empresa.com.br
SMTP_TLS=true

# Limites de alerta (% da cota)
ALERT_THRESHOLDS=70,85,95,100
