# Banco
DB_USER=fuel
DB_PASSWORD=fuel
DB_NAME=fuel
DATABASE_URL=postgresql+psycopg2://fuel:fuel@db:5432/fuel

# Sessão
SECRET_KEY=troque-isto-por-algo-bem-aleatorio

# Login do painel
AUTH_EMAIL=admin@empresa.com.br
AUTH_PASSWORD=trocar123

# Empresa (1 deploy = 1 empresa)
EMPRESA_NOME=Minha Empresa LTDA
EMPRESA_CNPJ=00000000000000        # apenas dígitos
COTA_LITROS=1220000
PERIODO_INICIO=2025-01-01
PERIODO_FIM=2025-06-30
EMAIL_ALERTAS=financeiro@empresa.com.br

# SIEG (cofre da contabilidade) - fonte primária quando preenchida.
# Pegue a chave em https://app.sieg.com (Minha Conta → API).
SIEG_API_KEY=

# SEFAZ direto - usado como fallback quando SIEG_API_KEY estiver vazio.
# Requer certificado A1 (.pfx) montado em ./certs.
CERT_PATH=/app/certs/certificado.pfx
CERT_PASSWORD=senha-do-certificado
SEFAZ_AMBIENTE=1                    # 1=produção, 2=homologação
SEFAZ_UF=SP                         # UF do consultante (cUFAutor)

# Polling (segundos)
POLL_INTERVAL=900                   # 15min
MIN_SEFAZ_INTERVAL=60               # intervalo mínimo entre consultas à fonte

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@empresa.com.br
SMTP_TLS=true

# Limites de alerta (% da cota)
ALERT_THRESHOLDS=70,85,95,100
